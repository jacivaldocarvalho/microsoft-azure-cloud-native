# Copy to app/.env and replace the placeholders. Do not commit app/.env.
# Use the full SQL hostname. The application and initializer share these names.
SQL_SERVER=your-server.database.windows.net
SQL_DATABASE=your-database
SQL_USERNAME=your-user
SQL_PASSWORD="replace-with-your-password"

# Required for uploads and authenticated image display; Terraform creates a private container.
AZURE_STORAGE_CONNECTION_STRING="replace-with-your-storage-connection-string"
AZURE_STORAGE_CONTAINER_NAME=products
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
